* { box-sizing: border-box; font-family: Roboto, "Segoe UI", sans-serif; }
body { margin: 0; background: #f5f7fa; color: #212529; }

/* TOPBAR */
.topbar {
  display: flex; align-items: center; gap: 24px;
  padding: 12px 20px; background: #fff;
  border-bottom: 1px solid #e9ecef; position: sticky; top: 0; z-index: 10;
}
.topbar h1 { font-size: 18px; margin: 0; color: #0684c6; }
.data-caixa { color: #495057; font-size: 13px; }
.resumo { margin-left: auto; display: flex; gap: 18px; font-size: 13px; }
.resumo .ok   { color: #2e7d32; }
.resumo .div  { color: #d32f2f; }
.resumo .pend { color: #ef6c00; }

/* LAYOUT */
.layout { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - 60px); }

/* FILTROS */
.filtros { background: #fff; padding: 16px; border-right: 1px solid #e9ecef; }
.filtros h3 { margin: 0 0 12px; font-size: 14px; color: #495057; }
.grupo { margin-bottom: 18px; }
.grupo > label {
  display: block; font-size: 12px; color: #868e96;
  margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px;
}
.grupo .check { display: flex; align-items: center; gap: 6px; font-size: 12px; margin: 4px 0; cursor: pointer; }
.grupo .check input { margin: 0; }

.filtro-item {
  display: flex; align-items: center; gap: 6px;
  padding: 4px 6px; border-radius: 4px; cursor: pointer; font-size: 12px;
}
.filtro-item:hover { background: #f1f3f5; }
.filtro-item input { margin: 0; }
.filtro-item .dot {
  width: 10px; height: 10px; border-radius: 50%;
  border: 2px solid #adb5bd; flex-shrink: 0;
}

/* GRADE DE CAIXAS */
.conteudo { padding: 20px; }
.grade {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 14px;
}

.caixa {
  background: #fff; border-radius: 8px;
  border: 2px solid #dee2e6;
  box-shadow: 0 1px 3px rgba(0,0,0,.06);
  overflow: hidden;
  transition: transform .12s ease, box-shadow .12s ease;
  position: relative;
}
.caixa:hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(0,0,0,.10); }
.caixa.conferida  { border-color: #69db7c; background: #f1fdf4; }
.caixa.divergente { border-color: #ff8787; background: #fff5f5; }
.caixa.pendente   { border-color: #ffd43b; }

.caixa-header {
  padding: 8px 10px; color: #fff; font-weight: 700;
  display: flex; justify-content: space-between; align-items: center;
}
.caixa-header .num  { font-size: 18px; }
.caixa-header .tipo { font-size: 11px; opacity: .9; }

.caixa-body { padding: 10px; font-size: 12px; }
.caixa-body .hospede {
  font-weight: 600; color: #343a40; margin-bottom: 4px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.caixa-body .linha {
  display: flex; justify-content: space-between;
  color: #868e96; margin-top: 3px;
}
.caixa-body .linha b { color: #495057; }

.caixa-footer { padding: 8px 10px; border-top: 1px solid #f1f3f5; display: flex; gap: 6px; }
.caixa-footer button {
  flex: 1; padding: 4px 6px; font-size: 11px; border-radius: 4px;
  border: 1px solid #ced4da; background: #f8f9fa; cursor: pointer;
}
.caixa-footer button:hover { background: #e9ecef; }

.badge-status {
  position: absolute; top: 8px; right: 8px;
  font-size: 10px; padding: 2px 6px; border-radius: 10px;
  background: rgba(255,255,255,.92); color: #343a40; font-weight: 700;
}

/* MODAL */
.modal {
  position: fixed; inset: 0; background: rgba(0,0,0,.5);
  display: flex; align-items: center; justify-content: center; z-index: 100;
}
.modal-box {
  background: #fff; border-radius: 10px; width: min(880px, 94vw);
  max-height: 92vh; overflow: auto; box-shadow: 0 10px 40px rgba(0,0,0,.3);
}
.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 18px; border-bottom: 1px solid #e9ecef;
}
.modal-header h2 { margin: 0; font-size: 16px; color: #0684c6; }
.btn-fechar {
  border: 0; background: transparent; font-size: 22px; cursor: pointer;
  line-height: 1; color: #868e96;
}
.modal-info {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 10px; padding: 12px 18px; font-size: 13px; background: #f8f9fa;
}

.abas {
  display: flex; gap: 4px; padding: 8px 18px 0;
  border-bottom: 1px solid #e9ecef;
}
.aba {
  border: 0; background: transparent; padding: 8px 14px;
  font-size: 13px; cursor: pointer; color: #868e96;
  border-bottom: 2px solid transparent;
}
.aba.ativa { color: #0684c6; border-bottom-color: #0684c6; font-weight: 600; }

.painel { padding: 0; }
.tabela-comandas { width: 100%; border-collapse: collapse; font-size: 13px; }
.tabela-comandas th, .tabela-comandas td {
  padding: 8px 10px; border-bottom: 1px solid #f1f3f5; text-align: left;
}
.tabela-comandas th { background: #f8f9fa; font-weight: 600; color: #495057; }
.tabela-comandas tr.ok  td { background: #f1fdf4; }
.tabela-comandas tr.div td { background: #fff5f5; }
.tabela-comandas input[type=checkbox] { transform: scale(1.2); cursor: pointer; }

.modal-obs { padding: 12px 18px; }
.modal-obs label { display: block; font-size: 12px; color: #868e96; margin-bottom: 4px; }
.modal-obs textarea {
  width: 100%; border: 1px solid #ced4da; border-radius: 4px;
  padding: 6px; font-size: 13px; resize: vertical;
}

.modal-footer {
  padding: 12px 18px; display: flex; gap: 8px; justify-content: flex-end;
  border-top: 1px solid #e9ecef;
}

/* BOTÕES */
.btn-primario, .btn-secundario {
  padding: 8px 14px; border-radius: 5px; font-size: 13px; cursor: pointer;
  border: 1px solid transparent; font-weight: 500;
}
.btn-primario  { background: #0684c6; color: #fff; border-color: #0684c6; }
.btn-primario:hover  { background: #00679d; }
.btn-secundario { background: #f8f9fa; color: #495057; border-color: #ced4da; }
.btn-secundario:hover { background: #e9ecef; }
.btn-secundario + .btn-secundario { margin-left: 4px; }

.vazio { text-align: center; color: #adb5bd; padding: 60px; font-size: 14px; }

/* Botão desabilitado dentro do card */
.caixa-footer button[disabled] {
  opacity: .5;
  cursor: not-allowed;
}

/* Badge de PDV e tag de cortesia (usados na lista de comandas) */
.pdv-badge {
  display: inline-block;
  background: #e9ecef;
  color: #495057;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-right: 6px;
  font-weight: 700;
}

.tag-cortesia {
  display: inline-block;
  background: #fff3bf;
  color: #946200;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 6px;
  font-weight: 700;
}

/* Select e date input do filtro de saída */
#filtro-saida-modo,
#filtro-saida-data {
  border: 1px solid #ced4da;
  border-radius: 4px;
  font-size: 12px;
}